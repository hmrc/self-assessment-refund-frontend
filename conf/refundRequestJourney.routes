# this file contains routes specific to SA Refund Request journey

GET         /refund-amount                           uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.SelectRepaymentAmountController.selectAmount
POST        /refund-amount                           uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.SelectRepaymentAmountController.submitAmount

GET         /how-you-will-get-the-refund             uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.HowYouWillGetYourRefundController.onPageLoad
GET         /how-your-client-will-get-the-refund     uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.HowYouWillGetYourRefundController.onPageLoadAgent
POST        /how-you-will-get-the-refund             uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.HowYouWillGetYourRefundController.onSubmit

GET         /we-need-your-bank-details               uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.WeNeedBankDetailsController.onPageLoad
GET         /we-need-your-clients-bank-details       uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.WeNeedBankDetailsController.onPageLoadAgent
POST        /we-need-your-bank-details               uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.WeNeedBankDetailsController.onSubmit

GET         /account-type                            uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.AccountTypeController.getAccountType
POST        /account-type                            uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.AccountTypeController.postAccountType

GET         /check-details                           uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.CheckYourDetailsPageController.start
POST        /check-details-confirm                   uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.CheckYourDetailsPageController.confirm
GET         /check-details-change-amount             uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.CheckYourDetailsPageController.changeAmount
GET         /check-details-change-account            uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.CheckYourDetailsPageController.changeAccount

GET         /enter-account-details                   uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.AccountDetailsController.getAccountDetails
POST        /enter-account-details                   uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.AccountDetailsController.postAccountDetails

GET         /sign-in-again                           uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.YouNeedToSignInAgainController.onPageLoad
POST        /sign-in-again                           uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.YouNeedToSignInAgainController.onSubmit

GET         /reauthentication                        uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.ReauthController.reauthentication

GET         /reauthenticated-submit                  uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.YouNeedToSignInAgainController.reauthSuccessful

GET         /refund-request-received/:number         uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.RepaymentConfirmationController.confirmation(number: RequestNumber)

GET         /refund-request-not-submitted            uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.YourRefundRequestNotSubmittedController.show

GET         /cannot-confirm-identity                 uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.WeCannotConfirmYourIdentityController.failedUplift(userType: String)

GET         /feedback                                uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.FeedbackController.feedbackShow

GET         /bank-details-tried-too-many-times       uk.gov.hmrc.selfassessmentrefundfrontend.controllers.refundRequestJourney.BarsLockoutController.barsLockout
